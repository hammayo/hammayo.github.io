# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Brainstorming session files
.superpowers/

# Git worktrees
.worktrees/

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE releted
.idea/
.specify/
.superpowers/
.playwright-mcp/
.obsidian/
.docs/
.claude/*
!.claude/commands/

# Blog automation — ephemeral cache, never commit
scripts/blog-automation/.last-briefing.json
scripts/blog-automation/topics-log.json
content/blogs/**/_social.md

# Blog — generated at build time
public/blog-assets/

# Keep screenshots for README.md
!public/screenshots/

